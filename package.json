{
  "name": "trust-center",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:up": "node scripts/pg-dev.mjs start",
    "db:down": "node scripts/pg-dev.mjs stop",
    "db:status": "node scripts/pg-dev.mjs status",
    "db:remove": "node scripts/pg-dev.mjs remove",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:harden": "node scripts/apply-immutability.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "setup:local": "node scripts/setup-local.mjs",
    "verify": "node --test \"tests/*.test.mjs\"",
    "test": "node --test \"tests/*.test.mjs\"",
    "security-gate": "node scripts/security-gate.mjs"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@aws-sdk/client-bedrock-runtime": "^3.1127.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.12.2",
    "nanoid": "^5.1.16",
    "next": "^15.5.25",
    "next-auth": "5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.7",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "17.10.0-beta.17",
    "postcss": "^8.5.23",
    "prisma": "^7.10.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "postcss": "^8.5.23",
    "uuid": "^11.1.1"
  }
}
