// Trust Center data model.
//
// Immutability note: DownloadRequest, NdaAcceptance and AuditLog are the
// append-only ledger. After creation their rows must never change. This is
// enforced two ways (see scripts/apply-immutability.mjs):
//   1. BEFORE UPDATE/DELETE triggers that RAISE EXCEPTION on those tables.
//   2. A restricted runtime DB role holding INSERT/SELECT only on them.
// SalesLead and DownloadGrant are deliberately mutable operational tables
// derived from / supporting the immutable ledger.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  VIEWER
}

enum DocumentCategory {
  POLICY
  PROCEDURE
  AUDIT
  CERTIFICATION
  REPORT
  WHITEPAPER
  LEGAL
  OTHER
}

enum DocumentVisibility {
  PUBLIC
  PRIVATE
}

enum RequesterClass {
  CUSTOMER
  LEAD
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / NextAuth) — extended with role, passwordHash, isActive.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(VIEWER)
  groupId       String?
  group         Group?    @relation(fields: [groupId], references: [id])
  passwordHash  String? // set for local/credentials admins; null for pure-SSO users
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  documents        Document[]
  documentVersions DocumentVersion[]
  savedViews       SavedView[]
  tickets          Ticket[]
  ticketComments   TicketComment[]
}

// A named filter/view a user saves on a list tab (e.g., "Q2 2026 requests").
model SavedView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  path      String // e.g. /admin/requests
  query     String // the saved search params
  createdAt DateTime @default(now())

  @@index([userId, path])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Documents & NDA templates (vendor-managed content).
// ---------------------------------------------------------------------------

model Document {
  id          String             @id @default(cuid())
  title       String
  description String?
  category    DocumentCategory
  visibility  DocumentVisibility @default(PRIVATE)
  storageKey  String // S3 object key (prod) or local relative path (dev)
  fileName    String
  mimeType    String
  sizeBytes   Int
  version     String             @default("1.0")
  status      String             @default("Draft") // Draft | In review | Planning | Published | Archived | Revoked
  isPublished Boolean            @default(false) // derived: status == "Published" (drives public visibility)

  // Taxonomy for the customer-facing filters (industry / region / framework).
  industries String[] @default([])
  regions    String[] @default([])
  frameworks String[] @default([])

  ndaTemplateId String? // optional per-document NDA override; else the default template
  ndaTemplate   NdaTemplate? @relation(fields: [ndaTemplateId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests DownloadRequest[]
  versions DocumentVersion[]

  @@index([visibility])
  @@index([category])
  @@index([isPublished])
}

model NdaTemplate {
  id             String  @id @default(cuid())
  name           String
  bodyMarkdown   String  @db.Text // NDA text (plain), also used for the acceptance hash
  contentHtml    String? @db.Text // sanitized rich-text version, rendered when present
  fileStorageKey String? // an uploaded NDA file (PDF/DOCX) shared as-is
  fileName       String?
  fileMimeType   String?
  isActive       Boolean @default(true)
  isDefault      Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  documents   Document[]
  acceptances NdaAcceptance[]
}

// ---------------------------------------------------------------------------
// Salesforce mock (customer directory) + derived sales leads.
// ---------------------------------------------------------------------------

model MockSalesforceCustomer {
  id                String   @id @default(cuid())
  accountName       String
  primaryDomain     String   @unique
  additionalDomains String[] // Postgres text[]
  tier              String // Enterprise | Mid-Market | SMB
  region            String
  accountOwner      String
  createdAt         DateTime @default(now())

  requests DownloadRequest[]

  @@index([primaryDomain])
}

// Mutable aggregate rebuilt from the immutable ledger for the leads dashboard.
model SalesLead {
  id            String   @id @default(cuid())
  emailDomain   String   @unique
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  requestCount  Int      @default(0)
  sampleOrgName String?
  sampleCountry String?
}

// ---------------------------------------------------------------------------
// Immutable ledger: capture, NDA consent, audit.
// ---------------------------------------------------------------------------

model DownloadRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  documentId         String
  document           Document           @relation(fields: [documentId], references: [id])
  documentTitle      String // snapshot at request time
  documentVersion    String? // version snapshot (point-in-time)
  documentCategory   DocumentCategory
  documentVisibility DocumentVisibility

  requesterName  String
  requesterEmail String
  emailDomain    String
  orgName        String
  country        String
  ipAddress      String?
  userAgent      String?

  ndaRequired Boolean
  batchId     String? // groups the per-document rows of a multi-select download

  classification      RequesterClass
  matchedCustomerId   String?
  matchedCustomer     MockSalesforceCustomer? @relation(fields: [matchedCustomerId], references: [id])
  matchedCustomerName String?

  ndaAcceptance NdaAcceptance?
  grant         DownloadGrant?

  @@index([emailDomain])
  @@index([createdAt])
  @@index([classification])
  @@index([documentId])
}

model NdaAcceptance {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  downloadRequestId String          @unique
  downloadRequest   DownloadRequest @relation(fields: [downloadRequestId], references: [id])

  ndaTemplateId   String
  ndaTemplate     NdaTemplate @relation(fields: [ndaTemplateId], references: [id])
  ndaTemplateName String // snapshot
  ndaBodyHash     String // sha256 of exact NDA text accepted

  signerName  String
  signerEmail String
  ipAddress   String?
  userAgent   String?
}

// Operational (mutable) grant for a multi-select ZIP download.
model BulkDownload {
  id             String    @id @default(cuid())
  token          String    @unique
  batchId        String
  requesterEmail String
  documentIds    String[]
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  usedAt         DateTime?
  downloadCount  Int       @default(0)
}

// Operational (mutable) download grant supporting the immutable request record.
model DownloadGrant {
  id                String   @id @default(cuid())
  token             String   @unique
  downloadRequestId String   @unique
  downloadRequest   DownloadRequest @relation(fields: [downloadRequestId], references: [id])
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  usedAt            DateTime?
  downloadCount     Int      @default(0)
}

// ---------------------------------------------------------------------------
// Trust-center content: subprocessors, knowledge base, updates.
// ---------------------------------------------------------------------------

model Subprocessor {
  id        String   @id @default(cuid())
  name      String
  purpose   String
  location  String
  website   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KnowledgeArticle {
  id             String  @id @default(cuid())
  title          String
  category       String  @default("General")
  bodyMarkdown   String  @db.Text @default("")
  contentHtml    String? @db.Text // sanitized rich text
  url            String? // external link, as an alternative to a body
  fileStorageKey String? // an attached document
  fileName       String?
  isPublished    Boolean @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished])
}

model TrustUpdate {
  id           String   @id @default(cuid())
  title        String
  bodyMarkdown String   @db.Text @default("")
  contentHtml  String?  @db.Text // sanitized rich text
  type         String   @default("update") // update | new | security | compliance
  publishedAt  DateTime @default(now())
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([publishedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorUserId String?
  actorEmail String?
  action     String // DOCUMENT_CREATE, DOCUMENT_PUBLISH, USER_INVITE, LOGIN, DOWNLOAD_REQUEST, NDA_ACCEPT, ...
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?

  @@index([createdAt])
  @@index([action])
}

// Singleton org/trust-center configuration (id is always "singleton").
model OrgSettings {
  id                String   @id @default("singleton")
  companyName       String?
  tagline           String?
  overview          String?  @db.Text
  supportEmail      String?
  statusPageUrl     String? // external system-status page
  primaryColor      String? // hex, applied as an accent
  showSubprocessors Boolean  @default(true)
  showKnowledge     Boolean  @default(true)
  showUpdates       Boolean  @default(true)
  grantTtlMinutes   Int      @default(15)
  retentionNote     String?  @db.Text
  updatedAt         DateTime @updatedAt
}

// Per-certification detail page content (how we comply, products in scope).
model Certification {
  id              String   @id @default(cuid())
  framework       String   @unique // matches Document.frameworks entries, e.g. "SOC 2"
  slug            String   @unique
  displayName     String
  summaryHtml     String?  @db.Text // sanitized rich text
  status          String   @default("Certified") // Certified | In progress | Planned
  productsInScope String[] @default([])
  isPublished     Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Risk profile: key security facts (RTO, RPO, encryption, ...). Only put here what
// isn't already obvious in the KB/RACI, to avoid duplication.
model RiskProfileItem {
  id          String   @id @default(cuid())
  category    String   @default("General")
  label       String
  value       String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Shared responsibility / RACI: who owns each control area.
model RaciItem {
  id          String   @id @default(cuid())
  area        String
  corporate   String   @default("")
  product     String   @default("")
  customer    String   @default("")
  note        String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Compliance calendar: planned audit windows / expected releases (free-text window
// keeps it flexible, e.g. "March – October (annual)" or "Expected Q3 2026").
model ComplianceEvent {
  id          String   @id @default(cuid())
  title       String
  detail      String?
  framework   String?
  product     String?
  window      String
  status      String   @default("planned") // planned | in-progress | complete
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Every stored version of a document (point-in-time). The Document row mirrors
// the latest version for convenience; history lives here.
model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version     String
  storageKey  String
  fileName    String
  mimeType    String
  sizeBytes   Int
  note        String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([documentId])
}

// Archiving hides requests from the working view WITHOUT touching the immutable
// ledger (insert-only; the DownloadRequest rows are never modified or deleted).
model RequestArchive {
  id                String   @id @default(cuid())
  downloadRequestId String   @unique
  archivedById      String?
  archivedByEmail   String?
  reason            String?
  archivedAt        DateTime @default(now())
}

// User groups (Legal, Sales, InfoSec…) with a default role members inherit.
model Group {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  defaultRole Role     @default(VIEWER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

// Integration placeholders (Salesforce, Google Drive, Okta, Google SSO, SES…).
model Integration {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  category  String
  status    String   @default("disconnected") // connected | disconnected
  note      String?
  updatedAt DateTime @updatedAt
}

// Admin-managed controlled vocabularies (the "Attribute Manager"). Each row is
// one option for one taxonomy, e.g. taxonomy="risk.category" value="Resilience".
// Drives the dropdowns/multi-selects across the admin forms so repeated values
// aren't free text. `taxonomy` keys are registered in src/lib/taxonomy.ts.
model TaxonomyOption {
  id        String   @id @default(cuid())
  taxonomy  String
  value     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxonomy, value])
  @@index([taxonomy])
}

// Light ticketing: user questions the assistant can't answer, plus manual entries.
model Ticket {
  id                  String   @id @default(cuid())
  subject             String
  question            String   @db.Text
  requesterName       String?
  requesterEmail      String?
  emailDomain         String?
  matchedCustomerName String?
  status              String   @default("open") // open | in-progress | resolved
  priority            String   @default("normal") // low | normal | high | urgent
  source              String   @default("assistant") // assistant | manual
  assignedToId        String?
  assignedTo          User?    @relation(fields: [assignedToId], references: [id])
  note                String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  comments TicketComment[]

  @@index([status])
  @@index([createdAt])
}

// Comment / activity thread on a ticket. `isInternal` marks staff-only notes;
// `system` rows are the audit trail (status changes, assignments) rendered inline.
model TicketComment {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id])
  authorEmail String?
  body        String   @db.Text
  isInternal  Boolean  @default(true)
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([ticketId])
}
