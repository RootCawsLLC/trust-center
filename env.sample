# Template for .env — copy to .env, or run `npm run setup:local` to generate one.
# Never commit the real .env.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/trustcenter?schema=public"

# Auth.js — generate a real secret: `openssl rand -base64 32`
AUTH_SECRET="replace-with-32-byte-random-secret"
AUTH_TRUST_HOST="true"
APP_URL="http://localhost:3000"

# Storage: 'local' writes blobs under ./storage ; 's3' uses S3 (prod).
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
AWS_REGION="us-east-1"
# S3_BUCKET="trust-center-docs-xxxx"

# SSO (scaffolded). Leave blank to keep a provider hidden; fill all of a
# provider's vars to light up its "Sign in with ..." button.
# OKTA_ISSUER="https://YOUR_ORG.okta.com/oauth2/default"
# OKTA_CLIENT_ID=""
# OKTA_CLIENT_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Seeded local admin + viewer (credentials login) for review before real SSO is
# wired. `npm run seed` refuses to run when NODE_ENV=production unless
# ALLOW_PRODUCTION_SEED=1 is set AND these are changed from the defaults below.
SEED_ADMIN_EMAIL="admin@trustcenter.local"
SEED_ADMIN_PASSWORD="ChangeMe!Admin123"
SEED_ADMIN_NAME="Trust Center Admin"
SEED_VIEWER_PASSWORD="ChangeMe!Viewer123"
